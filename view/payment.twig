{% extends "layout.twig" %}

{% block title %}Оплата{% endblock %}

{% block content %}
<section class="page-head">
    <div>
        <span class="eyebrow">Оплата</span>
        <h1>Подтвердите платеж</h1>
    </div>
</section>

{% if rental %}
    <section class="checkout-layout">
        <article class="summary-card payment-summary">
            <span class="summary-icon icon-card"></span>
            <h2>{{ rental.total_cost }} лей</h2>
            <p>Аренда #{{ rental.id }}</p>
            <p>С {{ rental.start_time }} до {{ rental.end_time }}</p>
        </article>

        <form class="checkout-form" method="post" action="{{ base }}/?page=payment&rental_id={{ rental.id }}">
            <input type="hidden" name="rental_id" value="{{ rental.id }}">

            <label for="payment_method">Способ оплаты</label>
            <select id="payment_method" name="payment_method">
                <option value="card" {{ old.payment_method|default('card') == 'card' ? 'selected' : '' }}>Банковская карта</option>
                <option value="online" {{ old.payment_method|default('card') == 'online' ? 'selected' : '' }}>Онлайн</option>
            </select>

            <label for="card_number">Номер карты</label>
            <input id="card_number" name="card_number" inputmode="numeric" maxlength="19" value="{{ old.card_number|default('') }}" placeholder="0000 0000 0000 0000" required>

            <label for="card_name">Имя на карте</label>
            <input id="card_name" name="card_name" type="text" value="{{ old.card_name|default('') }}" required>

            <div class="form-grid">
                <div>
                    <label for="expires">Срок</label>
                    <input id="expires" name="expires" type="text" value="{{ old.expires|default('') }}" placeholder="MM/YY" required>
                </div>
                <div>
                    <label for="cvv">CVV</label>
                    <input id="cvv" name="cvv" inputmode="numeric" maxlength="4" value="{{ old.cvv|default('') }}" required>
                </div>
            </div>

            <button class="btn btn-wide" type="submit">
                <span class="button-icon icon-lock"></span>Оплатить
            </button>
        </form>
    </section>
{% endif %}
{% endblock %}
