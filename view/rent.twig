{% extends "layout.twig" %}

{% block title %}Аренда{% endblock %}

{% block content %}
<section class="page-head">
    <div>
        <span class="eyebrow">Бронирование</span>
        <h1>Оформление аренды</h1>
    </div>
</section>

{% if car %}
    <section class="checkout-layout">
        <article class="summary-card">
            <span class="summary-icon icon-car"></span>
            <h2>{{ car.brand }} {{ car.model }}</h2>
            <p>{{ car.year }} • {{ car.fuel_type }} • {{ car.transmission }}</p>
            <div class="number_plate">{{ car.plate_number }}</div>
            <strong>{{ car.price_per_minute }} лей/мин</strong>
        </article>

        <form class="checkout-form" method="post" action="{{ base }}/?page=rent&car_id={{ car.id }}">
            <input type="hidden" name="car_id" value="{{ car.id }}">

            <label for="address">Адрес подачи</label>
            <input id="address" name="address" type="text" value="{{ old.address|default('') }}" placeholder="Кишинев, ул. Штефан чел Маре 1" required>

            <div class="form-grid">
                <div>
                    <label for="start_time">Начало</label>
                    <input id="start_time" name="start_time" type="datetime-local" value="{{ old.start_time|default('') }}" required>
                </div>
                <div>
                    <label for="end_time">Окончание</label>
                    <input id="end_time" name="end_time" type="datetime-local" value="{{ old.end_time|default('') }}" required>
                </div>
            </div>

            <button class="btn btn-wide" type="submit">
                <span class="button-icon icon-card"></span>Перейти к оплате
            </button>
        </form>
    </section>
{% endif %}
{% endblock %}
