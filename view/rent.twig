<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Бронирование</title>
</head>
<body>
    <h1>
        Бронирование
    </h1>

    <form action="">
        <label for="">Заполните следующие поля</label><br>
        <input type="text" placeholder="Местоположение/город/адрес"><br>
        <label for="">Дата и время начала</label><br>
        <input type="text" placeholder="01.01.1970 12:06">
        <span>10:10</span><br>

        <label for="">Дата и время конца</label><br>
        <input type="text" placeholder="01.01.1970 18:06">
        <span>10:10</span><br>
        <input type="submit" value = "Арендовать">
    </form>
</body>
</html>