{% extends "layout.twig" %}

{% block title %}Вход{% endblock %}

{% block content %}
<section class="auth-view">
    <div class="auth-panel">
        <div class="auth-copy">
            <span class="eyebrow">Каршеринг</span>
            <h1>Войдите, чтобы выбрать автомобиль</h1>
            <p>После входа вы сразу попадете на страницу выбора авто.</p>
        </div>

        <form class="auth-form" method="post" action="{{ base }}/?page=login">
            <label for="login">Email или логин администратора</label>
            <input id="login" name="login" type="text" value="{{ old.login|default('') }}" autocomplete="username" required>

            <label for="password">Пароль</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required>

            <button class="btn btn-wide" type="submit">
                <span class="button-icon icon-login"></span>Войти
            </button>

            <p class="form-note">Нет аккаунта? <a href="{{ base }}/?page=registration">Зарегистрироваться</a></p>
        </form>
    </div>
</section>
{% endblock %}
