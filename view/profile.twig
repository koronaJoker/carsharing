{% extends "layout.twig" %}

{% block title %}Профиль{% endblock %}

{% block content %}
<section class="profile-hero">
    <div class="avatar icon-user"></div>
    <div>
        <span class="eyebrow">Профиль водителя</span>
        <h1>{{ client.full_name }}</h1>
        <p>{{ client.email }} • {{ client.phone }}</p>
    </div>
</section>

<section class="profile-grid">
    <article class="profile-card">
        <span class="profile-icon icon-star"></span>
        <h2>Рейтинг водителя</h2>
        <strong>{{ client.driver_rating|default('5.0') }}</strong>
    </article>
    <article class="profile-card">
        <span class="profile-icon icon-license"></span>
        <h2>Удостоверение</h2>
        <strong>{{ client.driver_license }}</strong>
    </article>
    <article class="profile-card">
        <span class="profile-icon icon-id"></span>
        <h2>IDNP</h2>
        <strong>{{ client.idnp }}</strong>
    </article>
</section>

<section class="profile-actions">
    <a class="btn btn-secondary" href="{{ base }}/?page=payment"><span class="button-icon icon-card"></span>Оплата</a>
    <a class="btn btn-danger" href="{{ base }}/?page=logout"><span class="button-icon icon-login"></span>Выйти</a>
</section>
{% endblock %}
