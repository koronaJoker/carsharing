{% extends "layout.twig" %}

{% block title %}Выбор авто{% endblock %}

{% block content %}
<section class="page-head">
    <div>
        <span class="eyebrow">Доступные рядом</span>
        <h1>Выберите автомобиль</h1>
    </div>
    {% if activeRental %}
        <a class="btn btn-secondary" href="{{ base }}/?page=my_car">Текущая аренда</a>
    {% endif %}
</section>

<form class="filters-panel" method="get" action="{{ base }}/">
    <input type="hidden" name="page" value="cars">

    <label>
        <span>Бренд</span>
        <select name="brand">
            <option value="">Все бренды</option>
            {% for brand in filterOptions.brands %}
                <option value="{{ brand }}" {{ filters.brand == brand ? 'selected' : '' }}>{{ brand }}</option>
            {% endfor %}
        </select>
    </label>

    <label>
        <span>Топливо</span>
        <select name="fuel_type">
            <option value="">Любое</option>
            {% for fuelType in filterOptions.fuelTypes %}
                <option value="{{ fuelType }}" {{ filters.fuel_type == fuelType ? 'selected' : '' }}>{{ fuelType }}</option>
            {% endfor %}
        </select>
    </label>

    <label>
        <span>Коробка</span>
        <select name="transmission">
            <option value="">Любая</option>
            {% for transmission in filterOptions.transmissions %}
                <option value="{{ transmission }}" {{ filters.transmission == transmission ? 'selected' : '' }}>{{ transmission }}</option>
            {% endfor %}
        </select>
    </label>

    <label>
        <span>Год</span>
        <select name="year">
            <option value="">Любой</option>
            {% for year in filterOptions.years %}
                <option value="{{ year }}" {{ filters.year == year ? 'selected' : '' }}>{{ year }}</option>
            {% endfor %}
        </select>
    </label>

    <label>
        <span>Сортировка</span>
        <select name="sort">
            <option value="">По умолчанию</option>
            <option value="price_asc" {{ filters.sort == 'price_asc' ? 'selected' : '' }}>Цена: по возрастанию</option>
            <option value="price_desc" {{ filters.sort == 'price_desc' ? 'selected' : '' }}>Цена: по убыванию</option>
            <option value="year_desc" {{ filters.sort == 'year_desc' ? 'selected' : '' }}>Новее сначала</option>
            <option value="year_asc" {{ filters.sort == 'year_asc' ? 'selected' : '' }}>Старее сначала</option>
        </select>
    </label>

    <label class="price-filter">
        <span>Цена до <strong data-price-output>{{ priceLimit|number_format(2, '.', '') }}</strong> лей/мин</span>
        <input type="range" name="max_price" min="0" max="{{ filterOptions.maxPrice|default(0) }}" step="0.10" value="{{ priceLimit|number_format(2, '.', '') }}" data-price-range>
    </label>

    <div class="filters-actions">
        <button class="btn" type="submit">Показать</button>
        <a class="btn btn-secondary" href="{{ base }}/?page=cars">Сбросить</a>
    </div>
</form>

<section class="car-list">
    {% for car in cars %}
        <article class="car">
            <div class="car-media">
                <img src="{{ base }}/images/{{ car.image }}" alt="{{ car.brand }} {{ car.model }}" loading="lazy">
            </div>
            <div class="car-body">
                <div class="car-topline">
                    <h2>{{ car.brand }} {{ car.model }}</h2>
                    <span class="status-pill">{{ car.status == 'available' ? 'Свободна' : car.status }}</span>
                </div>
                <p class="car-info">{{ car.year }} • {{ car.fuel_type }} • {{ car.transmission }}</p>
                <div class="car-meta">
                    <span>{{ car.plate_number }}</span>
                    <strong>{{ car.price_per_minute }} лей/мин</strong>
                </div>
                <a class="btn btn-wide" href="{{ base }}/?page=rent&car_id={{ car.id }}">
                    <span class="button-icon icon-key"></span>Арендовать
                </a>
            </div>
        </article>
    {% else %}
        <div class="empty-state">
            <span class="empty-icon icon-alert"></span>
            <h2>Нет машин по выбранным фильтрам</h2>
            <p>Измените фильтры или сбросьте параметры.</p>
        </div>
    {% endfor %}
</section>
{% endblock %}
