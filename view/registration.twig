{% extends "layout.twig" %}

{% block title %}Регистрация{% endblock %}

{% block content %}
<section class="auth-view">
    <div class="auth-panel">
        <div class="auth-copy">
            <span class="eyebrow">Новый аккаунт</span>
            <h1>Создайте профиль водителя</h1>
            <p>Пароль будет сохранен в базе только в виде хеша.</p>
        </div>

        <form class="auth-form" method="post" action="{{ base }}/?page=registration">
            <label for="full_name">Имя и фамилия</label>
            <input id="full_name" name="full_name" type="text" value="{{ old.full_name|default('') }}" required>

            <label for="email">Email</label>
            <input id="email" name="email" type="email" value="{{ old.email|default('') }}" required>

            <div class="form-grid">
                <div>
                    <label for="phone">Телефон</label>
                    <input id="phone" name="phone" type="tel" value="{{ old.phone|default('') }}" placeholder="+37368111222" required>
                </div>
                <div>
                    <label for="idnp">IDNP</label>
                    <input id="idnp" name="idnp" type="text" value="{{ old.idnp|default('') }}" maxlength="13" required>
                </div>
            </div>

            <label for="driver_license">Водительское удостоверение</label>
            <input id="driver_license" name="driver_license" type="text" value="{{ old.driver_license|default('') }}" required>

            <div class="form-grid">
                <div>
                    <label for="password">Пароль</label>
                    <input id="password" name="password" type="password" autocomplete="new-password" required>
                </div>
                <div>
                    <label for="confirm_password">Повторите пароль</label>
                    <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required>
                </div>
            </div>

            <button class="btn btn-wide" type="submit">
                <span class="button-icon icon-user-plus"></span>Зарегистрироваться
            </button>

            <p class="form-note">Уже есть аккаунт? <a href="{{ base }}/?page=login">Войти</a></p>
        </form>
    </div>
</section>
{% endblock %}
