{% extends "layout.twig" %}

{% block title %}Аренда{% endblock %}

{% block content %}
<section class="page-head">
    <div>
        <span class="eyebrow">Текущая аренда</span>
        <h1>Мой автомобиль</h1>
    </div>
</section>

{% if car %}
    <section class="checkout-layout">
        <article class="summary-card">
            <span class="summary-icon icon-car"></span>
            <h2>{{ car.brand }} {{ car.model }}</h2>
            <p>{{ car.year }} • {{ car.fuel_type }} • {{ car.transmission }}</p>
            <div class="number_plate">{{ car.plate_number }}</div>
            <strong>{{ rental.total_cost }} лей</strong>
            {% if payment %}
                <span class="status-pill paid">Оплачено</span>
            {% endif %}
        </article>

        <form class="checkout-form car-control-form" method="post" action="{{ base }}/?page=car/action">
            <input type="hidden" name="car_id" value="{{ car.car_id }}">
            <button class="control-btn" name="action" value="blink" type="submit"><span class="icon-light"></span>Помигать</button>
            <button class="control-btn" name="action" value="warm" type="submit"><span class="icon-heat"></span>Прогреть</button>
            <button class="control-btn" name="action" value="lock" type="submit"><span class="icon-lock"></span>Закрыть</button>
            <button class="control-btn danger" name="action" value="finish" type="submit"><span class="icon-card"></span>Завершить</button>
        </form>
    </section>
{% else %}
    <div class="empty-state">
        <span class="empty-icon icon-car"></span>
        <h2>Активной аренды нет</h2>
        <p>Выберите автомобиль, чтобы начать поездку.</p>
        <a class="btn" href="{{ base }}/?page=cars">Выбрать авто</a>
    </div>
{% endif %}
{% endblock %}

{% block scripts %}
    {% if rental and rental.status == 'active' %}
        <script
            src="{{ base }}/scripts/gps-tracker.js?v=gps-3"
            data-gps-tracker
            data-rental-id="{{ rental.id|e('html_attr') }}"
            data-base-url="{{ base|e('html_attr') }}"
        ></script>
    {% endif %}
{% endblock %}
