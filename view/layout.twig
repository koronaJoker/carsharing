<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}{{ title|default('CarSharing') }}{% endblock %}</title>

    <!-- Стили -->
    <link rel="stylesheet" href="{{ base }}/styles/style.css">

    {% block styles %}{% endblock %}
</head>
<body>

<header>
    <h1>🚗 CarSharing</h1>

    <nav>
        <a href="{{ base }}/?page=home">Главная</a>
        <a href="{{ base }}/?page=my_car">Моя машина</a>
        <a href="{{ base }}/?page=profile">Профиль</a>
        <a href="{{ base }}/?page=admin/cars">Админка</a>
    </nav>
</header>

<hr>

<main>
    {% block content %}
    {% endblock %}
</main>

<hr>

<footer>
    <p>© {{ "now"|date("Y") }} CarSharing</p>
</footer>

{% block scripts %}{% endblock %}

</body>
</html>