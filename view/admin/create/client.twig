{% extends "admin/admin.twig" %}

{% block content %}
<h2>Добавить клиента</h2>

{% if error is defined %}
    <p style="color: red;">{{ error }}</p>
{% endif %}

{% include "admin/form/client.twig" with {
    client: client,
    form_action: "?page=admin/clients/create",
    submit_label: "Добавить",
    password_required: true,
    show_cancel: true
} %}
{% endblock %}
