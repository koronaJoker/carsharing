<form method="post" action="{{ form_action }}">

    <label>Бренд:</label>
    <input type="text" name="brand" value="{{ car.brand|default('') }}" required>

    <br><br>

    <label>Модель:</label>
    <input type="text" name="model" value="{{ car.model|default('') }}" required>

    <br><br>

    <label>Год:</label>
    <input type="number" name="year" min="1990" value="{{ car.year|default('') }}" required>

    <br><br>

    <label>Номер (plate):</label>
    <input type="text" name="plate_number" value="{{ car.plate_number|default('') }}" required>

    <br><br>

    <label>Тип топлива:</label>
    <select name="fuel_type">
        <option value="petrol" {% if car.fuel_type|default('') == 'petrol' %}selected{% endif %}>Бензин</option>
        <option value="diesel" {% if car.fuel_type|default('') == 'diesel' %}selected{% endif %}>Дизель</option>
        <option value="electric" {% if car.fuel_type|default('') == 'electric' %}selected{% endif %}>Электро</option>
        <option value="hybrid" {% if car.fuel_type|default('') == 'hybrid' %}selected{% endif %}>Гибрид</option>
        <option value="gas" {% if car.fuel_type|default('') == 'gas' %}selected{% endif %}>Газ</option>
    </select>

    <br><br>

    <label>Коробка передач:</label>
    <select name="transmission">
        <option value="manual" {% if car.transmission|default('') == 'manual' %}selected{% endif %}>Механика</option>
        <option value="automatic" {% if car.transmission|default('') == 'automatic' %}selected{% endif %}>Автомат</option>
    </select>

    <br><br>

    <label>Цена за минуту:</label>
    <input type="number" step="0.01" name="price_per_minute" value="{{ car.price_per_minute|default('') }}" required>

    <br><br>

    <label>Статус:</label>
    <select name="status">
        <option value="available" {% if car.status|default('available') == 'available' %}selected{% endif %}>Доступна</option>
        <option value="rented" {% if car.status|default('') == 'rented' %}selected{% endif %}>Арендована</option>
        <option value="maintenance" {% if car.status|default('') == 'maintenance' %}selected{% endif %}>Обслуживание</option>
        <option value="inactive" {% if car.status|default('') == 'inactive' %}selected{% endif %}>Неактивна</option>
    </select>

    <br><br>

    <button type="submit">{{ submit_label|default('Сохранить') }}</button>

    {% if show_cancel|default(false) %}
        <a href="?page=admin/cars">Назад</a>
    {% endif %}
</form>
