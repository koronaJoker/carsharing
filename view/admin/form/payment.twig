<form method="post" action="{{ form_action }}">
    <label>Аренда ID:</label>
    <input type="number" name="rental_id" value="{{ payment.rental_id|default('') }}" required>

    <br><br>

    <label>Сумма:</label>
    <input type="number" step="0.01" name="amount" value="{{ payment.amount|default('') }}" required>

    <br><br>

    <label>Метод оплаты:</label>
    <select name="payment_method" required>
        <option value="cash" {% if payment.payment_method|default('') == 'cash' %}selected{% endif %}>Наличные</option>
        <option value="card" {% if payment.payment_method|default('card') == 'card' %}selected{% endif %}>Карта</option>
        <option value="online" {% if payment.payment_method|default('') == 'online' %}selected{% endif %}>Онлайн</option>
    </select>

    <br><br>

    <label>Статус:</label>
    <select name="payment_status" required>
        <option value="pending" {% if payment.payment_status|default('pending') == 'pending' %}selected{% endif %}>Ожидает</option>
        <option value="paid" {% if payment.payment_status|default('') == 'paid' %}selected{% endif %}>Оплачен</option>
        <option value="failed" {% if payment.payment_status|default('') == 'failed' %}selected{% endif %}>Ошибка</option>
        <option value="refunded" {% if payment.payment_status|default('') == 'refunded' %}selected{% endif %}>Возврат</option>
    </select>

    <br><br>

    <label>Дата оплаты:</label>
    <input type="datetime-local" name="paid_at" value="{{ payment.paid_at|default('')|replace({' ': 'T'})|slice(0, 16) }}">

    <br><br>

    <button type="submit">{{ submit_label|default('Сохранить') }}</button>

    {% if show_cancel|default(false) %}
        <a href="?page=admin/payments">Назад</a>
    {% endif %}
</form>
