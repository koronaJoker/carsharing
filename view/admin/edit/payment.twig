{% extends "admin/admin.twig" %}

{% block content %}
<h2>Редактировать платеж</h2>

{% if error is defined %}
    <p style="color: red;">{{ error }}</p>
{% endif %}

{% include "admin/form/payment.twig" with {
    payment: payment,
    form_action: "?page=admin/payments/update&id=" ~ payment.id,
    submit_label: "Сохранить",
    show_cancel: true
} %}
{% endblock %}
