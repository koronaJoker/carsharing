{% extends "admin/admin.twig" %}

{% block content %}
<h2>Админ > Клиенты</h2>

<div class="admin-actions">
    <a class="btn" href="?page=admin/clients/create">Добавить клиента</a>
</div>

<table border="1" cellpadding="5">
    <tr>
        <th>ID</th>
        <th>ФИО</th>
        <th>Email</th>
        <th>Телефон</th>
        <th>IDNP</th>
        <th>Права</th>
        <th>Рейтинг</th>
        <th>Действия</th>
    </tr>

    {% for client in clients %}
        <tr>
            <td>{{ client.id }}</td>
            <td>{{ client.full_name }}</td>
            <td>{{ client.email }}</td>
            <td>{{ client.phone }}</td>
            <td>{{ client.idnp }}</td>
            <td>{{ client.driver_license }}</td>
            <td>{{ client.driver_rating }}</td>
            <td>
                <a class="action-icon edit-icon" href="?page=admin/clients/edit&id={{ client.id }}" title="Редактировать" aria-label="Редактировать">&#9998;</a>
                <a class="action-icon delete-icon" href="?page=admin/clients/delete&id={{ client.id }}" title="Удалить" aria-label="Удалить" onclick="return confirm('Удалить клиента?')">&times;</a>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="8">Нет клиентов</td>
        </tr>
    {% endfor %}
</table>
{% endblock %}
