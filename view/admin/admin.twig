<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Админ панель</title>
    <script>
        try {
            document.documentElement.dataset.theme = localStorage.getItem('theme') || 'light';
        } catch (error) {
            document.documentElement.dataset.theme = 'light';
        }
    </script>
    <link rel="stylesheet" href="styles/style.css?v=admin-layout-14">
</head>
<body class="admin-page">

<header class="admin-header">
    <div class="admin-shell">
        <h1>Админ панель</h1>

        <nav class="admin-nav">
            <a href="?page=cars">Сайт</a>
            <a href="?page=admin/cars">Машины</a>
            <a href="?page=admin/clients">Клиенты</a>
            <a href="?page=admin/payments">Платежи</a>
            <a href="?page=admin/rentals">Аренды</a>
            <a href="?page=admin/fines">Штрафы</a>
            <a href="?page=logout">Выйти</a>
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Переключить тему" title="День / ночь">
            <span class="theme-track">
                <span class="theme-sun" aria-hidden="true"></span>
                <span class="theme-moon" aria-hidden="true"></span>
                <span class="theme-thumb"></span>
            </span>
        </button>
    </div>
</header>

<main class="admin-shell admin-content">
    {% block content %}{% endblock %}
</main>

<script src="scripts/index.js?v=app-2"></script>

</body>
</html>
