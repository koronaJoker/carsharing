{% extends "layout.twig" %}

{% block title %}Мои адреса{% endblock %}

{% block content %}
<section class="page-head">
    <div>
        <span class="eyebrow">Личные места</span>
        <h1>Мои адреса</h1>
    </div>
</section>

<section class="address-layout">
    <form class="address-form" method="post" action="{{ base }}/?page=adress/action">
        <input type="hidden" name="action" value="create">

        <label for="title">Название</label>
        <input id="title" name="title" type="text" value="{{ old.title|default('') }}" placeholder="Дом" required>

        <label for="address">Адрес</label>
        <input id="address" name="address" type="text" value="{{ old.address|default('') }}" placeholder="Кишинев, ул. Штефан чел Маре 1" required>

        <label for="coordinates">Координаты</label>
        <input id="coordinates" name="coordinates" type="text" value="{{ old.coordinates|default('') }}" placeholder="47.049769001929626, 28.864979562989657" required>

        <button class="btn btn-wide" type="submit">Добавить адрес</button>
    </form>

    <section class="address-list">
        {% for adress in adresses %}
            <article class="address-card">
                <form method="post" action="{{ base }}/?page=adress/action">
                    <input type="hidden" name="id" value="{{ adress.id }}">

                    <div class="address-card-head">
                        <strong>{{ adress.title }}</strong>
                        <a class="btn btn-secondary" href="{{ adress.maps_url }}" target="_blank" rel="noopener">Google Maps</a>
                    </div>

                    <label for="title-{{ adress.id }}">Название</label>
                    <input id="title-{{ adress.id }}" name="title" type="text" value="{{ adress.title }}" required>

                    <label for="address-{{ adress.id }}">Адрес</label>
                    <input id="address-{{ adress.id }}" name="address" type="text" value="{{ adress.address }}" required>

                    <label for="coordinates-{{ adress.id }}">Координаты</label>
                    <input id="coordinates-{{ adress.id }}" name="coordinates" type="text" value="{{ adress.latitude }}, {{ adress.longitude }}" placeholder="47.049769001929626, 28.864979562989657" required>

                    <div class="address-actions">
                        <button class="btn" name="action" value="update" type="submit">Обновить</button>
                        <button class="btn btn-danger" name="action" value="delete" type="submit" formnovalidate onclick="return confirm('Удалить этот адрес?')">Удалить</button>
                    </div>
                </form>
            </article>
        {% else %}
            <div class="empty-state">
                <span class="empty-icon icon-alert"></span>
                <h2>Адресов пока нет</h2>
                <p>Добавьте место с широтой и долготой, чтобы быстро открыть его на карте.</p>
            </div>
        {% endfor %}
    </section>
</section>
{% endblock %}
